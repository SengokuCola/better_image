{
  "manifest_version": 2,
  "version": "1.1.5",
  "name": "Better Image",
  "description": "提供互联网搜图、历史消息图片提取、裁切和放大工具。",
  "author": {
    "name": "SengokuCola",
    "url": "https://github.com/SengokuCola"
  },
  "license": "MIT",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "image",
      "background": "#1C272C"
    }
  },
  "urls": {
    "repository": "https://github.com/SengokuCola/better_image",
    "homepage": "https://github.com/SengokuCola/better_image",
    "documentation": "https://github.com/SengokuCola/better_image",
    "issues": "https://github.com/SengokuCola/better_image/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.9.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.28.1"
    },
    {
      "type": "python_package",
      "name": "pillow",
      "version_spec": ">=11.3.0"
    }
  ],
  "capabilities": [
    "message.get_by_id"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "sengokucola.better-image"
}
